generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("Admins")
}

model Hospital {
  id          String            @id @default(uuid())
  name        String
  address     String
  phone       String?
  nif         String            @unique
  email       String            @unique
  password    String
  role        RoleHospitals     @default(admin)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @default(now()) @map("updated_at")
  status      HospitalStatus    @default(ACTIVE)
  doctors     Doctor[]
  images      ImagesHospitals[]
  specialties Specialty[]
  notifications Notification[]
  pushTokens   ExpoPushToken[]

  @@map("Hospitals")
}

model Patient {
  id              String            @id @default(uuid())
  name            String
  email           String?           @unique
  password        String?
  tokenVersion    Int               @default(0) @map("token_version")
  photo           String?
  phone           String?
  dateBirth       DateTime?
  address         String?
  gender          String?
  pushToken       String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @map("updated_at")
  Appointment     Appointment[]
  history_Medical history_Medical[]
  notifications    Notification[]
  pushTokens       ExpoPushToken[]

  @@map("Patients")
}

model Doctor {
  id                String            @id @default(uuid())
  name              String
  photo             String?
  email             String            @unique
  password          String?
  phone             String?
  bio               String?
  address           String?
  yaersOfExperience Int?
  numberOfPatients  Int?
  rating            Float?
  specialtyId       String
  hospitalId        String?
  pushToken         String?
  status            DoctorStatus      @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @map("updated_at")
  Appointment       Appointment[]
  Hospital          Hospital?         @relation(fields: [hospitalId], references: [id])
  Specialty         Specialty         @relation(fields: [specialtyId], references: [id])
  Doctor_Service    Doctor_Service[]
  Availability      Availability[]
  DoctorSchedule    DoctorSchedule?
  history_Medical   history_Medical[]
  notifications     Notification[]
  pushTokens        ExpoPushToken[]

  @@map("Doctors")
}

model Appointment {
  id              String   @id @default(uuid())
  patientId       String
  doctorId        String
  serviceId       String
  status          String   @default("Pendente")
  bookingDate     DateTime @map("booking_date")
  bookingHour     String   @map("booking_hour")
  createdAt       DateTime @default(now()) @map("createdAt")
  upadatedAt      DateTime @default(now())
  bookingEnd      String?  @map("booking_end")
  durationMinutes Int?     @map("duration_minutes")
  Doctor          Doctor   @relation(fields: [doctorId], references: [id])
  Patient         Patient  @relation(fields: [patientId], references: [id])
  Service         Service  @relation(fields: [serviceId], references: [id])
  rescheduleProposals RescheduleProposal[]
  notifications      Notification[]

  @@index([patientId, bookingDate])
  @@index([doctorId, bookingDate])
  @@map("Appointments")
}

model Specialty {
  id          String    @id @default(uuid())
  name        String
  description String
  color       String
  hospitalId  String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  doctor      Doctor[]
  Services    Service[]
  hospital    Hospital  @relation(fields: [hospitalId], references: [id])

  @@map("Specialties")
}

model Service {
  id             String           @id @default(uuid())
  title          String
  description    String?
  status         String           @default("activo")
  duraction      String?
  specialtyId    String?
  price          Float
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @default(now()) @map("updated_at")
  Appointment    Appointment[]
  Doctor_Service Doctor_Service[]
  specialty      Specialty?       @relation(fields: [specialtyId], references: [id])

  @@map("Services")
}

model Doctor_Service {
  doctorId        String
  serviceId       String
  price           Float
  created_at      DateTime @default(now())
  durationMinutes Int      @default(45) @map("duration_minutes")
  Doctor          Doctor   @relation(fields: [doctorId], references: [id])
  Service         Service  @relation(fields: [serviceId], references: [id])

  @@id([doctorId, serviceId])
  @@map("Doctors_Services")
}

model DoctorSchedule {
  id                String              @id @default(uuid())
  doctorId          String              @unique
  timezone          String              @default("Africa/Luanda")
  bookingWindowDays Int                 @default(90) @map("booking_window_days")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  doctor            Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  exceptions        ScheduleException[]
  rules             ScheduleRule[]

  @@map("doctor_schedules")
}

model ScheduleRule {
  id             String         @id @default(uuid())
  scheduleId     String         @map("schedule_id")
  weekday        Int
  startMinute    Int            @map("start_minute")
  endMinute      Int            @map("end_minute")
  isActive       Boolean        @default(true) @map("is_active")
  effectiveFrom  DateTime?      @map("effective_from") @db.Date
  effectiveUntil DateTime?      @map("effective_until") @db.Date
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  availabilities Availability[]
  schedule       DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, weekday, isActive])
  @@map("schedule_rules")
}


model ScheduleException {
  id             String                @id @default(uuid())
  scheduleId     String                @map("schedule_id")
  date           DateTime              @db.Date
  type           ScheduleExceptionType
  startMinute    Int?                  @map("start_minute")
  endMinute      Int?                  @map("end_minute")
  reason         String?
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")

  schedule       DoctorSchedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  availabilities Availability[]

  @@index([scheduleId, date])
  @@map("schedule_exceptions")
}

model Availability {
  id                  String                   @id @default(uuid())
  doctorId            String
  date                DateTime
  hourStart           DateTime
  hourEnd             DateTime
  isBlocked           Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  scheduleRuleId      String?                  @map("schedule_rule_id")
  scheduleExceptionId String?                  @map("schedule_exception_id")

  doctor              Doctor                   @relation(fields: [doctorId], references: [id])
  scheduleRule        ScheduleRule?            @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  scheduleException   ScheduleException?       @relation(fields: [scheduleExceptionId], references: [id], onDelete: SetNull)

  @@unique([scheduleRuleId, date])
  @@unique([doctorId, date, hourStart, hourEnd])
  @@index([doctorId, date])
  @@index([scheduleExceptionId])
  @@map("availabilities")
}


model history_Medical {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  diagnosis String
  treatment String
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
  Doctor    Doctor   @relation(fields: [doctorId], references: [id])
  Patient   Patient  @relation(fields: [patientId], references: [id])

  @@map("history_medicals")
}

model ImagesHospitals {
  id         String   @id @default(uuid())
  urlImagem  String
  hospitalId String
  Hospital   Hospital @relation(fields: [hospitalId], references: [id])

  @@map("Images_Hospitals")
}

enum RoleHospitals {
  admin
  owner
  doctor
}

enum HospitalStatus {
  ACTIVE
  SUSPENDED
}

enum DoctorStatus {
  ACTIVE
  INACTIVE
}

enum ScheduleExceptionType {
  BLOCK_DAY
  BLOCK_PERIOD
  EXTRA_PERIOD
}


enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  RESCHEDULE_PROPOSED
  RESCHEDULE_ACCEPTED
  RESCHEDULE_REJECTED
}

enum NotificationRecipientRole {
  PATIENT
  DOCTOR
  HOSPITAL
}

enum RescheduleProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RescheduleActorRole {
  doctor
  hospital
}

model RescheduleProposal {
  id              String                   @id @default(uuid())
  appointmentId   String                   @map("appointment_id")
  proposedById    String                   @map("proposed_by_id")
  proposedByRole  RescheduleActorRole      @map("proposed_by_role")
  proposedDate    DateTime                 @db.Date @map("proposed_date")
  proposedHour    String                   @map("proposed_hour")
  proposedEnd     String?                  @map("proposed_end")
  durationMinutes Int                      @map("duration_minutes")
  reason          String?
  status          RescheduleProposalStatus @default(PENDING)
  respondedAt     DateTime?                @map("responded_at")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  appointment     Appointment              @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, status])
  @@map("reschedule_proposals")
}

model Notification {
  id                  String                    @id @default(uuid())
  title               String
  message             String
  type                NotificationType
  recipientRole       NotificationRecipientRole @map("recipient_role")
  patientId           String?                   @map("patient_id")
  doctorId            String?                   @map("doctor_id")
  hospitalId          String?                   @map("hospital_id")
  appointmentId       String                    @map("appointment_id")
  rescheduleProposalId String?                  @map("reschedule_proposal_id")
  data                Json?
  isRead              Boolean                   @default(false) @map("is_read")
  createdAt           DateTime                  @default(now()) @map("created_at")
  patient             Patient?                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor              Doctor?                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital            Hospital?                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointment         Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  pushJob             NotificationPushJob?

  @@index([patientId, isRead, createdAt])
  @@index([doctorId, isRead, createdAt])
  @@index([hospitalId, isRead, createdAt])
  @@index([appointmentId, createdAt])
  @@map("notifications")
}


model ExpoPushToken {
  id           String                    @id @default(uuid())
  token        String                    @unique
  recipientRole NotificationRecipientRole @map("recipient_role")
  patientId    String?                   @map("patient_id")
  doctorId     String?                   @map("doctor_id")
  hospitalId   String?                   @map("hospital_id")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")
  patient      Patient?                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor?                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital     Hospital?                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@map("expo_push_tokens")
}

model NotificationPushJob {
  id             String       @id @default(uuid())
  notificationId String       @unique @map("notification_id")
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at")
  lockedAt       DateTime?    @map("locked_at")
  sentAt         DateTime?    @map("sent_at")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt, createdAt])
  @@map("notification_push_jobs")
}
