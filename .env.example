DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=3333
NODE_ENV=development
ORIGIN_CORS="http://localhost:8081"

# Supabase Storage (backend only; never expose the service role key in the frontend)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="uploads"

# Segredos da autenticação própria do backend
JwtSecret="REPLACE_WITH_A_LONG_RANDOM_SECRET"
# Configuração temporária para criar o primeiro administrador
# BOOTSTRAP_ADMIN_NAME="Nome do administrador"
# BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="Use-uma-senha-forte-com-pelo-menos-12-caracteres"
